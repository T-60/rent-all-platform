# 🔧 Configuración de Entorno - RENT+ALL
# Copia este archivo como .env.local y configura tus valores

# ==============================================
# 🌐 API CONFIGURATION
# ==============================================
# Para desarrollo local (puerto estándar)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Para pruebas en red local (se configura automáticamente)
# El sistema detecta tu IP automáticamente cuando usas --hostname 0.0.0.0

# ==============================================
# 🗄️ DATABASE CONFIGURATION  
# ==============================================
# ✅ CONFIGURACIÓN AUTOMÁTICA (Recomendado)
# El proyecto usa MongoDB Atlas preconfigurado para desarrollo
# No necesitas configurar nada - funciona sin configuración

# 🔧 CONFIGURACIÓN MANUAL (Opcional)
# Si quieres usar tu propia base de datos:
# MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@cluster.mongodb.net/rentall

# Para obtener MongoDB Atlas GRATIS:
# 1. Ve a https://www.mongodb.com/atlas
# 2. Crea cuenta gratuita (512MB gratis)
# 3. Crea cluster gratuito
# 4. Obtén connection string
# 5. Reemplaza TU_USUARIO y TU_PASSWORD
# 4. Ve a "Database Access" y crea un usuario
# 5. Ve a "Clusters" > "Connect" > "Connect your application"
# 6. Copia la connection string y reemplaza <password> con tu contraseña

# ==============================================
# 🔐 SECURITY
# ==============================================
# JWT Secret - Usa una cadena larga y segura para producción
JWT_SECRET=tu_jwt_secret_muy_seguro_para_desarrollo_12345_cambiar_en_produccion

# ==============================================
# 📁 FILE UPLOAD CONFIGURATION
# ==============================================
# Tamaño máximo de archivos en bytes (25MB por defecto)
MAX_FILE_SIZE=26214400

# Tipos de archivo permitidos
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ==============================================
# 🌍 CORS CONFIGURATION
# ==============================================
# Orígenes permitidos para CORS
CORS_ORIGIN=http://localhost:3000

# Para múltiples orígenes (separados por comas):
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://tu-dominio.com

# ==============================================
# 📧 EMAIL CONFIGURATION (Opcional)
# ==============================================
# Para envío de emails de verificación y notificaciones
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-password-de-app
# FROM_EMAIL=noreply@rentall.com

# ==============================================
# 🔧 DEVELOPMENT SETTINGS
# ==============================================
# Nivel de logs (error, warn, info, debug)
LOG_LEVEL=debug

# Puerto del backend (por defecto 3001)
PORT=3001

# Entorno de ejecución
NODE_ENV=development

# ==============================================
# 📊 ANALYTICS (Opcional)
# ==============================================
# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==============================================
# 🚀 DEPLOYMENT SETTINGS (Para producción)
# ==============================================
# URL base de la aplicación en producción
# NEXT_PUBLIC_BASE_URL=https://tu-dominio.com

# Base URL del API en producción
# NEXT_PUBLIC_API_URL=https://api.tu-dominio.com/api

# MongoDB URI para producción (usar Atlas)
# MONGODB_URI=mongodb+srv://prod_user:prod_pass@cluster-prod.mongodb.net/rentall_prod

# JWT Secret para producción (generar uno seguro)
# JWT_SECRET=super_secreto_jwt_para_produccion_generar_uno_nuevo

# ==============================================
# 📝 NOTAS IMPORTANTES
# ==============================================
# 
# 1. NUNCA subas el archivo .env.local al repositorio
# 2. Cambia JWT_SECRET en producción por algo más seguro
# 3. Para MongoDB Atlas, asegúrate de agregar tu IP a la whitelist
# 4. En producción, usa variables de entorno del servidor/hosting
# 5. Para desarrollo local, solo necesitas cambiar MONGODB_URI si usas Atlas
#
# Generador de JWT Secret seguro:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
