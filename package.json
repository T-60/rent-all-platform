{
  "name": "rent-all-platform",
  "version": "1.0.0",
  "description": "Plataforma de alquiler de productos entre estudiantes universitarios",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev --hostname 0.0.0.0",
    "dev:full": "./scripts/start-development.sh",
    "dev:full:windows": "scripts\\start-development.bat",
    "dev:background": "scripts\\dev-background.bat",
    "dev:single": "scripts\\start-dev-simple.bat",
    "dev:simple": "scripts\\dev-simple.bat",
    "dev:ps": "powershell -ExecutionPolicy Bypass -File scripts\\start-dev.ps1",
    "dev:setup": "copy .env.development .env.local && npm install --legacy-peer-deps && cd backend && npm install && cd ..",
    "dev:stop": "./scripts/stop-development.sh",
    "dev:stop:windows": "scripts\\stop-development.bat",
    "dev:logs": "scripts\\view-logs.bat",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "setup": "cp .env.example .env.local && pnpm install && cd backend && npm install",
    "setup:quick": "pnpm install && cd backend && npm install",
    "backend": "cd backend && node server.js",
    "backend:dev": "cd backend && npm run dev",
    "demo": "./start-demo.sh",
    "demo:windows": "start-demo.bat",
    "full-dev": "concurrently \"cd backend && node server.js\" \"pnpm dev:network\"",
    "full-dev:local": "concurrently \"cd backend && node server.js\" \"pnpm dev\"",
    "test-data": "node create-test-user.js",
    "health-check": "curl http://localhost:3001/api/health",
    "clean": "rm -rf .next node_modules backend/node_modules",
    "clean:cache": "rm -rf .next",
    "reinstall": "pnpm run clean && pnpm install && cd backend && npm install",
    "deploy:prod": "./scripts/deploy-production.sh",
    "deploy:prod:silent": "./scripts/deploy-production-silent.sh",
    "setup:gcp": "./scripts/setup-gcp.sh",
    "monitor": "./scripts/monitor.sh",
    "dev:prod": "cp .env.production .env.local && npm run build && npm start",
    "postinstall": "echo '✅ Instalación completada. Ejecuta: pnpm demo'"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "autoprefixer": "^10.4.20",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "8.5.1",
    "form-data": "^4.0.3",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "next": "15.2.4",
    "next-themes": "^0.4.4",
    "react": "^19",
    "react-day-picker": "8.10.1",
    "react-dom": "^19",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "socket.io-client": "^4.8.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8",
    "puppeteer": "^24.10.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
